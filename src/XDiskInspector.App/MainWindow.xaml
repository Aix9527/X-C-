<Window x:Class="XDiskInspector.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:XDiskInspector.App"
        Title="X C盘巡检官" Width="1360" Height="860" MinWidth="1100" MinHeight="700" WindowStartupLocation="CenterScreen">
  <Grid Background="{StaticResource BgBrush}">
    <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="#12181C" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0" Padding="16">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top">
          <StackPanel Orientation="Horizontal" Margin="4,8,4,24">
            <Border Width="42" Height="42" CornerRadius="21" BorderBrush="{StaticResource CyanBrush}" BorderThickness="2"><TextBlock Text="X" FontSize="22" FontWeight="Bold" Foreground="{StaticResource CyanBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
            <StackPanel Margin="10,0,0,0"><TextBlock Text="C盘巡检官" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="解释 · 判断 · 保守清理" FontSize="11" Foreground="{StaticResource MutedBrush}"/></StackPanel>
          </StackPanel>
          <Button Content="首页" Command="{Binding NavigateCommand}" CommandParameter="0" HorizontalContentAlignment="Left"/>
          <Button Content="扫描结果" Command="{Binding NavigateCommand}" CommandParameter="1" HorizontalContentAlignment="Left"/>
          <Button Content="安全清理" Command="{Binding NavigateCommand}" CommandParameter="2" HorizontalContentAlignment="Left"/>
          <Button Content="系统优化建议" Command="{Binding NavigateCommand}" CommandParameter="3" HorizontalContentAlignment="Left"/>
          <Button Content="关于与报告" Command="{Binding NavigateCommand}" CommandParameter="4" HorizontalContentAlignment="Left"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom"><TextBlock Text="规则库" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding RuleVersionText}" Foreground="{StaticResource CyanBrush}"/><TextBlock Text="首次打开不自动扫描、不自动提权。" FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,10,0,0"/></StackPanel>
      </DockPanel>
    </Border>

    <TabControl x:Name="MainTabs" Grid.Column="1" SelectedIndex="{Binding SelectedPageIndex, Mode=TwoWay}" Background="Transparent" BorderThickness="0" SelectionChanged="MainTabs_OnSelectionChanged">
      <TabControl.Template><ControlTemplate TargetType="TabControl"><ContentPresenter ContentSource="SelectedContent"/></ControlTemplate></TabControl.Template>

      <TabItem>
        <Grid Margin="30"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <StackPanel><TextBlock Text="X C盘巡检官" FontSize="34" FontWeight="SemiBold"/><TextBlock Text="先解释空间去哪了，再决定什么可以动。" Foreground="{StaticResource MutedBrush}" FontSize="15"/></StackPanel>
          <Grid Grid.Row="1" Margin="0,24,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="400"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="18" Padding="24" Margin="0,0,18,0">
              <StackPanel HorizontalAlignment="Center"><Grid Width="280" Height="280"><local:CapacityRing Value="{Binding DiskUsedPercent}" IsScanning="{Binding IsScanning}"/><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="C:" FontSize="24" HorizontalAlignment="Center"/><TextBlock Text="{Binding DiskUsedPercentText}" FontSize="42" FontWeight="Bold" Foreground="{StaticResource CyanBrush}"/><TextBlock Text="已使用" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center"/></StackPanel></Grid>
                <Grid Width="330" Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="总容量" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding DiskTotalText}" FontSize="17"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="已用" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding DiskUsedText}" FontSize="17"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="可用" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding DiskFreeText}" FontSize="17" Foreground="{StaticResource CyanBrush}"/></StackPanel></Grid>
              </StackPanel>
            </Border>
            <StackPanel Grid.Column="1">
              <Border Background="{StaticResource PanelBrush}" CornerRadius="16" Padding="22"><StackPanel><TextBlock Text="开始一次可解释的巡检" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="只读取文件系统元数据；默认不跟随重解析点、联接或符号链接。" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,14"/><StackPanel Orientation="Horizontal"><Button Content="开始扫描" Command="{Binding StartScanCommand}" Style="{StaticResource PrimaryButton}"/><Button Content="载入上次报告" Command="{Binding LoadLastReportCommand}"/><Button Content="安全清理" Command="{Binding NavigateCommand}" CommandParameter="2" Style="{StaticResource WarningButton}"/></StackPanel><StackPanel Orientation="Horizontal" Margin="4,12,0,0"><TextBlock Text="大文件阈值 MB" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/><TextBox Text="{Binding LargeFileThresholdMb, UpdateSourceTrigger=LostFocus}" Width="100" Margin="10,0,0,0"/></StackPanel></StackPanel></Border>
              <Border Background="{StaticResource PanelBrush}" CornerRadius="16" Padding="22" Margin="0,16,0,0"><StackPanel><DockPanel><TextBlock Text="扫描状态" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{Binding ScanStatus}" DockPanel.Dock="Right" Foreground="{StaticResource CyanBrush}"/></DockPanel><TextBlock Text="{Binding CurrentPath}" TextTrimming="CharacterEllipsis" Margin="0,12,0,0"/><WrapPanel Margin="0,12,0,0"><TextBlock Text="文件：" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding FileCountText}"/><TextBlock Text="  逻辑容量：" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding ScannedSizeText}"/><TextBlock Text="  耗时：" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding ElapsedText}"/></WrapPanel><Button Content="取消扫描" Command="{Binding CancelScanCommand}" Style="{StaticResource DangerButton}" Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}" HorizontalAlignment="Left" Margin="0,14,0,0"/></StackPanel></Border>
            </StackPanel>
          </Grid>
        </Grid>
      </TabItem>

      <TabItem>
        <Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <DockPanel><StackPanel><TextBlock Text="扫描结果" FontSize="30" FontWeight="SemiBold"/><TextBlock Text="{Binding ScanCompletenessText}" Foreground="{StaticResource MutedBrush}"/><WrapPanel Margin="0,4,0,0"><TextBlock Text="可访问文件逻辑总量：" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding AccessibleLogicalText}" Foreground="{StaticResource CyanBrush}" FontWeight="SemiBold"/><TextBlock Text="  · 当前规则：" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding RuleVersionText}"/></WrapPanel></StackPanel><Button Content="重新扫描" Command="{Binding StartScanCommand}" DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}"/></DockPanel>
          <WrapPanel Grid.Row="1" Margin="0,14,0,8"><TextBlock Text="筛选" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="4"/><ComboBox ItemsSource="{Binding RiskFilters}" SelectedItem="{Binding RiskFilter}" Width="100" Margin="4"/><ComboBox ItemsSource="{Binding RecommendationFilters}" SelectedItem="{Binding RecommendationFilter}" Width="140" Margin="4"/><TextBox Text="{Binding SoftwareFilter, UpdateSourceTrigger=PropertyChanged}" Width="150" Margin="4" ToolTip="软件名称筛选"/><TextBox Text="{Binding MinimumSizeMb, UpdateSourceTrigger=LostFocus}" Width="90" Margin="4" ToolTip="最小容量 MB"/><Button Content="全选建议项" Command="{Binding SelectSuggestedCommand}" Style="{StaticResource PrimaryButton}"/><Button Content="一键全选" Command="{Binding SelectAllCommand}" Style="{StaticResource PrimaryButton}" ToolTip="全选当前筛选结果中所有可选择项目"/><Button Content="取消全选" Command="{Binding ClearSelectionCommand}"/><TextBlock Text="软件分类" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="12,4,4,4"/><ComboBox ItemsSource="{Binding SoftwareCategories}" SelectedItem="{Binding SelectedSoftwareCategory}" Width="180" Margin="4"/><Button Content="分类全选" Command="{Binding SelectSoftwareCommand}" Style="{StaticResource PrimaryButton}" ToolTip="全选当前筛选结果中所选软件分类的可选择项目"/></WrapPanel>
          <TabControl Grid.Row="2">
            <TabItem Header="清理候选">
              <DataGrid ItemsSource="{Binding CandidateView}" IsReadOnly="False" IsEnabled="{Binding IsSelectionEditable}">
                <DataGrid.Columns>
                  <DataGridTemplateColumn Header="选" Width="42" SortMemberPath="Selected"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Selectable}" HorizontalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                  <DataGridTextColumn Header="路径" Binding="{Binding Path}" Width="*" IsReadOnly="True"/>
                  <DataGridTextColumn Header="容量（字节）" Binding="{Binding SizeBytes}" Width="130" IsReadOnly="True"/>
                  <DataGridTextColumn Header="软件" Binding="{Binding Software}" Width="140" IsReadOnly="True"/>
                  <DataGridTextColumn Header="风险" Binding="{Binding RiskText}" Width="68" IsReadOnly="True"/>
                  <DataGridTextColumn Header="删除后果" Binding="{Binding Consequence}" Width="220" IsReadOnly="True"/>
                  <DataGridTextColumn Header="建议" Binding="{Binding RecommendationText}" Width="100" IsReadOnly="True"/>
                </DataGrid.Columns>
              </DataGrid>
            </TabItem>
            <TabItem Header="主要占用"><DataGrid ItemsSource="{Binding MainOccupancies}"><DataGrid.Columns><DataGridTextColumn Header="目录" Binding="{Binding Path}" Width="*"/><DataGridTextColumn Header="容量（字节）" Binding="{Binding SizeBytes}" Width="150"/></DataGrid.Columns></DataGrid></TabItem>
            <TabItem Header="重点目录"><DataGrid ItemsSource="{Binding HighlightView}"><DataGrid.Columns><DataGridTextColumn Header="路径" Binding="{Binding Path}" Width="*"/><DataGridTextColumn Header="容量（字节）" Binding="{Binding SizeBytes}" Width="130"/><DataGridTextColumn Header="软件/系统" Binding="{Binding Software}" Width="145"/><DataGridTextColumn Header="用途" Binding="{Binding Purpose}" Width="190"/><DataGridTextColumn Header="风险" Binding="{Binding RiskText}" Width="70"/><DataGridTextColumn Header="删除后果" Binding="{Binding Consequence}" Width="220"/><DataGridTextColumn Header="建议" Binding="{Binding RecommendationText}" Width="105"/><DataGridTextColumn Header="禁止/说明" Binding="{Binding BlockedReason}" Width="190"/></DataGrid.Columns></DataGrid></TabItem>
            <TabItem Header="大文件"><DataGrid ItemsSource="{Binding LargeFileView}"><DataGrid.Columns><DataGridTextColumn Header="路径" Binding="{Binding Path}" Width="*"/><DataGridTextColumn Header="容量（字节）" Binding="{Binding SizeBytes}" Width="140"/><DataGridTextColumn Header="识别" Binding="{Binding Software}" Width="145"/><DataGridTextColumn Header="风险" Binding="{Binding RiskText}" Width="68"/><DataGridTextColumn Header="建议" Binding="{Binding RecommendationText}" Width="105"/><DataGridTextColumn Header="禁止原因" Binding="{Binding BlockedReason}" Width="210"/></DataGrid.Columns></DataGrid></TabItem>
          </TabControl>
          <Border Grid.Row="3" Background="#202A31" CornerRadius="12" Padding="10" Margin="0,10,0,0"><DockPanel><Button Content="一键删除已选项" Command="{Binding ExecuteCleanupCommand}" DockPanel.Dock="Right" Style="{StaticResource DangerButton}"/><StackPanel><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="已选 "/><TextBlock Text="{Binding SelectedCount}" Foreground="{StaticResource CyanBrush}" FontWeight="Bold"/><TextBlock Text=" 项 · 预计逻辑容量 "/><TextBlock Text="{Binding SelectedBytesText}" FontWeight="Bold"/><TextBlock Text=" · 最高风险 "/><TextBlock Text="{Binding HighestSelectedRiskText}" Foreground="{StaticResource OrangeBrush}"/></StackPanel><TextBlock Text="预计容量是文件逻辑大小，不等同于精确可回收的磁盘空间；实际释放量以清理结果为准。" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/></StackPanel></DockPanel></Border>
        </Grid>
      </TabItem>

      <TabItem>
        <Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="安全清理" FontSize="30" FontWeight="SemiBold"/><TextBlock Text="最终执行前重新计算清单、重新校验规则与路径；回收站需要独立不可恢复确认。" Foreground="{StaticResource MutedBrush}"/></StackPanel>
          <Grid Grid.Row="1" Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><GroupBox Header="建议清理 / 需要确认"><DataGrid ItemsSource="{Binding CandidateView}" IsReadOnly="False" IsEnabled="{Binding IsSelectionEditable}"><DataGrid.GroupStyle><GroupStyle><GroupStyle.HeaderTemplate><DataTemplate><Border Background="#202A31" Padding="8,5" Margin="0,6,0,2"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{StaticResource CyanBrush}"/></Border></DataTemplate></GroupStyle.HeaderTemplate></GroupStyle></DataGrid.GroupStyle><DataGrid.Columns><DataGridTemplateColumn Header="选" Width="42"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Selectable}" HorizontalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="路径" Binding="{Binding Path}" Width="*" IsReadOnly="True"/><DataGridTextColumn Header="预计字节" Binding="{Binding SizeBytes}" Width="105" IsReadOnly="True"/><DataGridTextColumn Header="风险" Binding="{Binding RiskText}" Width="68" IsReadOnly="True"/><DataGridTextColumn Header="后果" Binding="{Binding Consequence}" Width="210" IsReadOnly="True"/><DataGridTextColumn Header="恢复说明" Binding="{Binding RecoveryText}" Width="260" IsReadOnly="True"/></DataGrid.Columns></DataGrid></GroupBox><StackPanel Grid.Column="1" Margin="12,0,0,0"><GroupBox Header="仅提供操作指导"><ListBox ItemsSource="{Binding GuidanceItems}" Background="{StaticResource PanelBrush}" MaxHeight="260"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="6"><TextBlock Text="{Binding Software}" FontWeight="SemiBold"/><TextBlock Text="{Binding Path}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="11"/><TextBlock Text="{Binding Guidance}" Foreground="{StaticResource OrangeBrush}" TextWrapping="Wrap"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></GroupBox><GroupBox Header="执行结果"><DataGrid ItemsSource="{Binding CleanupResults}" Height="250"><DataGrid.Columns><DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="80"/><DataGridTextColumn Header="路径" Binding="{Binding Path}" Width="*"/><DataGridTextColumn Header="实际释放" Binding="{Binding FreedBytes}" Width="95"/><DataGridCheckBoxColumn Header="需重启" Binding="{Binding RequiresRestart}" Width="72" IsReadOnly="True"/><DataGridTextColumn Header="说明" Binding="{Binding Message}" Width="180"/></DataGrid.Columns></DataGrid></GroupBox></StackPanel></Grid>
          <DockPanel Grid.Row="2" Margin="0,10,0,0"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="停止后续项目" Command="{Binding StopCleanupCommand}" Style="{StaticResource WarningButton}" Visibility="{Binding IsCleanupRunning, Converter={StaticResource BoolToVisibility}}"/><Button Content="一键删除已选项" Command="{Binding ExecuteCleanupCommand}" Style="{StaticResource DangerButton}"/></StackPanel><TextBlock Text="清理期间选择列表锁定；停止只阻止后续项目，不强制中断正在执行的单个文件操作。" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/></DockPanel>
        </Grid>
      </TabItem>

      <TabItem>
        <ScrollViewer><StackPanel Margin="30" MaxWidth="980" HorizontalAlignment="Left"><TextBlock Text="系统优化建议" FontSize="30" FontWeight="SemiBold"/><TextBlock Text="页面文件只检测；组件存储仅使用 DISM；软件卸载走系统页面；WSL/Docker VHDX 只提供官方指导。" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,16"/><ItemsControl ItemsSource="{Binding OptimizationItems}"><ItemsControl.ItemTemplate><DataTemplate><Border Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="16" Margin="0,0,0,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{Binding Detail}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,14,0"/></StackPanel><Button Grid.Column="1" Content="{Binding ActionLabel}" Command="{Binding DataContext.RunOptimizationActionCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Style="{StaticResource WarningButton}"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="需要管理员权限的官方操作只在你明确点击后请求 UAC；不夺取所有权、不结束进程、不修改 ACL。" Foreground="{StaticResource OrangeBrush}" TextWrapping="Wrap"/></StackPanel></ScrollViewer>
      </TabItem>

      <TabItem>
        <Grid Margin="30"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="420"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="关于 X C盘巡检官" FontSize="30" FontWeight="SemiBold"/><TextBlock Text="先解释占用、展示风险，再只允许通过白名单的保守清理。" Foreground="{StaticResource MutedBrush}" FontSize="16" Margin="0,8,0,20"/><Border Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="18"><StackPanel><TextBlock Text="作者：Aix"/><TextBlock Text="抖音：xch03209527" Margin="0,8,0,0"/><TextBlock Text="GitHub：Aix9527/Codex-Doctor" Margin="0,8,0,0"/><TextBlock Text="规则版本：" Foreground="{StaticResource MutedBrush}" Margin="0,12,0,0"/><TextBlock Text="{Binding RuleVersionText}" Foreground="{StaticResource CyanBrush}"/></StackPanel></Border><TextBlock Text="报告与日志不记录文件内容、浏览器凭据、API Key 或其他密钥。" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,20,0,0"/></StackPanel><Border Grid.Column="1" Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="20" Margin="22,0,0,0" VerticalAlignment="Top"><StackPanel><TextBlock Text="报告导出" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="支持 JSON 与 HTML，保存目录由你选择。" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,14"/><Button Content="导出 JSON 报告" Command="{Binding ExportJsonCommand}" Style="{StaticResource PrimaryButton}"/><Button Content="导出 HTML 报告" Command="{Binding ExportHtmlCommand}"/><Separator Margin="0,14"/><TextBlock Text="{Binding ScanCompletenessText}" TextWrapping="Wrap"/></StackPanel></Border></Grid>
      </TabItem>
    </TabControl>
  </Grid>
</Window>